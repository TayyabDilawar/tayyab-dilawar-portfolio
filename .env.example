# Public site URL used for canonical links, sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Displayed GitHub username (does not call the GitHub API).
NEXT_PUBLIC_GITHUB_USERNAME=YOUR_GITHUB

# Public profile links
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/YOUR_LINKEDIN
NEXT_PUBLIC_EMAIL=YOUR_EMAIL

# Add provider keys only on the server when you wire email delivery:
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
# FORMSPREE_ENDPOINT=
